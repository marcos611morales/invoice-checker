# URL pública de la app (local: http://localhost:3000). Debe coincidir con el URI de redirección de Google: <URL>/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:3000
# Secreto para cifrar la cookie de sesión, mínimo 32 caracteres (genera uno con: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# ID de cliente OAuth de Google (inicio de sesión: solo identidad, scopes openid email profile)
GOOGLE_CLIENT_ID=
# Secreto de cliente OAuth de Google
GOOGLE_CLIENT_SECRET=
# Correos con acceso, separados por comas. Solo vive en el servidor; no se edita desde la app
ALLOWED_EMAILS=dueno@example.com,socio@example.com
# Credenciales de Drive del dueño (las configura el plan 01-02 con pnpm drive:auth)
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
DRIVE_REFRESH_TOKEN=
# Carpeta de facturas por defecto en Drive (opcional; la fuente de verdad es Ajustes)
DRIVE_FOLDER_ID=
# Poner en 1 para omitir la validación de variables (solo CI o compilaciones sin secretos)
SKIP_ENV_VALIDATION=
# URL ya desplegada para las pruebas E2E (si no se define, se usa el servidor local)
E2E_BASE_URL=
